@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)
find_dependency(executor CONFIG)
find_dependency(OpenSSL 3.0 COMPONENTS SSL Crypto)
# M9-19: libnice builds install LibDataChannel with $<LINK_ONLY:LibNice::LibNice>
# in its exported link interface, and the upstream LibDataChannel config does
# not find libnice for consumers, so define the target here first (through the
# pinned dependency's own find modules, installed under modules/).
if(@HEYAKI_ICE_BACKEND@ STREQUAL "nice" AND NOT TARGET LibNice::LibNice)
  list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")
  find_dependency(LibNice)
endif()
find_dependency(LibDataChannel 0.23 CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/heyakiTargets.cmake")
check_required_components(heyaki)
